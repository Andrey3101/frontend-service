{
  "name": "frontend-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "test:unit": "jest",
    "test:e2e": "cypress run",
    "build:prod": "vue-cli-service build --mode production"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.67.1",
    "axios": "^1.8.1",
    "chart.js": "^4.4.0",
    "core-js": "^3.8.3",
    "dayjs": "^1.11.13",
    "jspdf": "^3.0.0",
    "jspdf-autotable": "^5.0.2",
    "lodash": "^4.17.21",
    "pinia": "^3.0.1",
    "three": "^0.158.0",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.5.0",
    "vue-the-mask": "^0.11.1",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-animate-onscroll": "^1.0.6",
    "vuetify": "^3.7.19",
    "xlsx": "^0.18.5",
    "js-cookie": "^3.0.5",
    "crypto-js": "^4.2.0",
    "chartjs-adapter-dayjs": "^1.0.1",
    "dayjs": "^1.11.13",
    "vuetify-datetime-picker": "^2.0.0",
    "webxr-polyfill": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.26.8",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "jest": "^29.0.0",
    "cypress": "^13.0.0",
    "sass": "^1.69.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "vue/no-unused-vars": "warn",
      "no-console": "warn"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
